# ═══════════════════════════════════════════════════════════════════════════════
# CodebaseCopilot — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is listed in .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# When running locally (no Docker for the backend):
COPILOT_DB_HOST=127.0.0.1
COPILOT_DB_PORT=5433
# When running inside Docker Compose the backend uses DB host "db" automatically.

COPILOT_DB_NAME=copilot_db
COPILOT_DB_USER=copilot_user
COPILOT_DB_PASSWORD=replace-with-your-secure-password

# ── Ollama ─────────────────────────────────────────────────────────────────────
# Local development (Ollama installed on host):
OLLAMA_BASE_URL=http://localhost:11434
# Inside Docker Compose the backend uses http://host.docker.internal:11434 automatically.

OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_KEEP_ALIVE=10m
# Increase if your hardware needs more time for inference:
OLLAMA_CHAT_READ_TIMEOUT=420s

# ── Docker port overrides (optional) ──────────────────────────────────────────
# Change these to avoid conflicts with other services on your machine.
# COPILOT_DB_EXTERNAL_PORT=5433
# BACKEND_EXTERNAL_PORT=8080
# FRONTEND_EXTERNAL_PORT=3000
